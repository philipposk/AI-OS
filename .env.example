# Copy to .env and fill in. Never commit .env.
# At least ONE provider key is required.

# Anthropic (recommended for planning + coding)
ANTHROPIC_API_KEY=

# OpenRouter (multi-model aggregator)
OPENROUTER_API_KEY=

# NVIDIA NIM (free tier available)
NVCF_API_KEY=

# Ollama (local). Default URL works if `ollama serve` is running.
OLLAMA_BASE_URL=http://localhost:11434

# Default models per task type. Override here or in router config.
ROUTER_MODEL_ANALYZE=claude-haiku-4-5
ROUTER_MODEL_PLAN=claude-opus-4-7
ROUTER_MODEL_CODE=claude-sonnet-4-6
ROUTER_MODEL_REVIEW=claude-haiku-4-5

# Slack (optional; only needed for slack bot in Phase F+)
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# Storage paths
AI_COMPANY_DB=./data/ai_company.sqlite
AI_COMPANY_CHROMA_DIR=./data/chroma

# ──────────────────────────────────────────────────────────────────────
# Phase Z / Z2 — self-improvement layers. ALL DEFAULT-OFF.
# Each layer falls back to the legacy path on any error. Flip on one at
# a time. See README → "Self-improvement loop" for the full activation
# table.
# ──────────────────────────────────────────────────────────────────────

# Persistent LangGraph state — workflows survive process restart.
# Unset = in-memory only (MemorySaver). Set = SqliteSaver.
# LANGGRAPH_CHECKPOINT_DB=./data/langgraph.sqlite

# DSPy-tuned prompts (analyze/plan/review).
# Loaded from JSON only after `cli.py tune run|auto` produces the file.
# USE_LEARNED_PROMPTS=1
# LEARNED_PROMPTS_PATH=./data/learned_prompts.json

# Auto-pick highest-success (provider, model) from retrospective history.
# Falls back to ROUTER_MODEL_<TASK> if no learned data exists.
# USE_LEARNED_MODELS=1
# BEST_MODEL_MAX_COST_PER_CALL=0.05

# Auto-tune cron thresholds. Paired with: `cli.py tune auto` in cron.
# AUTO_TUNE_MIN_TOTAL=20
# AUTO_TUNE_MIN_NEW=10
# AUTO_TUNE_STATE_PATH=./data/auto_state.json
# AUTO_TUNE_TASK_TYPES=plan,analyze,review

# Litellm = default provider for task_types lacking ROUTER_MODEL_<TASK>.
# Pick LITELLM_DEFAULT_MODEL to match a provider key you already have:
#   groq/llama-3.3-70b-versatile     (free, needs GROQ_API_KEY)
#   anthropic/claude-haiku-4-5       (paid, needs ANTHROPIC_API_KEY)
#   openai/gpt-4o-mini               (paid, needs OPENAI_API_KEY)
# LITELLM_PRIMARY=1
# LITELLM_DEFAULT_MODEL=groq/llama-3.3-70b-versatile
# LITELLM_TASK_MODEL_CODE=anthropic/claude-sonnet-4-6

# Instructor + pydantic typed plan/review (uses litellm under the hood).
# Same caveat as LITELLM_*: STRUCTURED_MODEL must match a provider key.
# USE_STRUCTURED_OUTPUTS=1
# STRUCTURED_MODEL=groq/llama-3.3-70b-versatile
